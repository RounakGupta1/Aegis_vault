# Database
# Local: mongodb://127.0.0.1:27017/aegis
# Atlas: mongodb+srv://USER:PASS@cluster/aegis?retryWrites=true&w=majority
DATABASE_URL=

# HTTP
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# Cookie domain. Leave empty for localhost and Render default hostnames.
COOKIE_DOMAIN=

# Secrets: generate with `openssl rand -base64 48`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PRELOGIN_PEPPER=

# Session lifetimes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REMEMBER_DEVICE_TTL_DAYS=30
ACCOUNT_LOCK_THRESHOLD=8
ACCOUNT_LOCK_MINUTES=15

# Optional SMTP. If omitted, verification/reset links print to the server console in development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Aegis Vault <noreply@localhost>
